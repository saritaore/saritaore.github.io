@unpublished{waterincentive,
  keywords={  Work in Progress},
  title={Incentives, Externalities, and Health: Evidence from Performance Transfers in Peru's Sanitation Sector},
  author={Caloi, Luigi},
  status={Data construction.},
  description={Central governments increasingly use performance-based transfers to improve local service delivery. But when neighbors matter for the production of a public good, these incentives may not work as intended. How should performance transfers be designed when local governments' actions generate externalities across jurisdictions? We study this question using performance-based transfers for sanitation services in Peruvian municipalities.},
  selected={true},
  ordering={    }
}

